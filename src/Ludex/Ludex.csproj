<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ludex</AssemblyName>
    <RootNamespace>GameVault</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.21.7</Version>
    <FileVersion>1.21.7.0</FileVersion>
    <Product>Ludex</Product>
    <Company>Ludex</Company>
    <Description>Ludex - local game library with automatic artwork</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>

    <!-- Обрезка неиспользуемого кода: 215 файлов → ~90, 92 МБ → ~42 МБ.
         Настройки и библиотека пишутся через System.Text.Json, поэтому
         рефлексию сериализатора нужно оставить включённой. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!--
      IL2026: анализатор предупреждает про System.Text.Json с рефлексией. У нас это безопасно:
      настройки, библиотека и кэши — это наши собственные модели из этой же сборки, которая
      в partial-режиме не обрезается (см. TrimmerRootAssembly), а сериализатор получает
      TypeInfoResolver по умолчанию. Проверено вживую на trimmed-сборке: library.json и
      settings.json читаются и пишутся. Полноценное решение — source-generated контексты.
    -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- модели из этой сборки нужны сериализатору целиком -->
    <TrimmerRootAssembly Include="Ludex" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Avalonia.Labs.Gif" Version="11.3.1" />
  </ItemGroup>

</Project>
